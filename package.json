{
  "name": "bingo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:all": "concurrently --kill-others --names BE,FE \"npm run dev --prefix server\" \"npm run dev\"",
    "build": "tsc -b && vite build --mode prod",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "verify": "npm run check && npm run typecheck",
    "verify:fix": "npm run format && npm run typecheck",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check . --write --error-on-warnings",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint . --write --error-on-warnings",
    "format": "npm run check:fix",
    "format:check": "biome format . --error-on-warnings",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node --import tsx --test tests/unit/*.test.mts",
    "test:backend": "npm test --prefix server",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:all": "npm test && npm run test:e2e",
    "deps:check": "npm run deps:check:frontend && npm run deps:check:backend",
    "deps:check:frontend": "ncu --packageFile package.json",
    "deps:check:backend": "cd server && ncu --packageFile package.json",
    "deps:update": "npm run deps:update:frontend && npm run deps:update:backend",
    "deps:update:frontend": "ncu --packageFile package.json -u && npm install",
    "deps:update:backend": "cd server && ncu --packageFile package.json -u && npm install",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,cjs,mjs,json,jsonc,css}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
