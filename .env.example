# Frontend: .env.dev (lokalny backend), .env.prod (Render) i panel Netlify (Builds / Production).
VITE_SERVER_URL=
# Panel Netlify: wersja Node do builda; sam wpis w .env.prod jej nie ustawia.
NODE_VERSION=
# Panel Netlify: 0 wylacza hooki Husky podczas instalacji na hostingu.
HUSKY=
# Panel Netlify: --include=dev instaluje narzedzia potrzebne do builda.
NPM_FLAGS=
